    <script>
      (function () {
        // Audience toggle (For Agents / For Humans)
        var audienceTabs = document.querySelectorAll('.why-join-tab');
        var modules = document.querySelectorAll('.wj-module');

        audienceTabs.forEach(function (tab) {
          tab.addEventListener('click', function () {
            var audience = tab.getAttribute('data-audience');

            audienceTabs.forEach(function (t) {
              t.classList.remove('is-active');
              t.setAttribute('aria-selected', 'false');
            });
            tab.classList.add('is-active');
            tab.setAttribute('aria-selected', 'true');

            modules.forEach(function (m) {
              if (m.getAttribute('data-audience') === audience) {
                m.hidden = false;
                // Reset to first item
                selectItem(m, 0);
              } else {
                m.hidden = true;
              }
            });
          });
        });

        // Item selection within a module
        function selectItem(mod, index) {
          mod.querySelectorAll('.wj-item').forEach(function (item) {
            var i = parseInt(item.getAttribute('data-index'));
            item.classList.toggle('is-active', i === index);
            item.setAttribute('aria-selected', i === index ? 'true' : 'false');
          });
          mod.querySelectorAll('.wj-detail-inner').forEach(function (panel) {
            var i = parseInt(panel.getAttribute('data-index'));
            panel.classList.toggle('is-active', i === index);
          });
        }

        // Bind click handlers on all wj-items
        document.querySelectorAll('.wj-item').forEach(function (item) {
          item.addEventListener('click', function () {
            var mod = item.closest('.wj-module');
            var index = parseInt(item.getAttribute('data-index'));
            selectItem(mod, index);
          });
        });
      })();
    </script>

