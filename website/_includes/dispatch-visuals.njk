{% elif cardImage == "failure-modes" %}
<svg viewBox="0 0 400 140" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="dv-fm-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#130f30"/>
      <stop offset="100%" stop-color="#1a1840"/>
    </linearGradient>
  </defs>
  <rect width="400" height="140" fill="url(#dv-fm-bg)"/>
  <!-- 6 shapes in a 3×2 grid — each representing a failure mode -->
  <!-- Cell centres: y=48 and y=95; x=65, 200, 335 -->
  <!-- 1: Circle — resource starvation (shrinking inward) -->
  <circle cx="65" cy="48" r="22" fill="none" stroke="#7C3AED" stroke-width="1.5" opacity="0.75"/>
  <circle cx="65" cy="48" r="14" fill="none" stroke="#7C3AED" stroke-width="1" opacity="0.5"/>
  <circle cx="65" cy="48" r="7" fill="#7C3AED" opacity="0.45"/>
  <!-- 2: Triangle — coercive override (pressure from above) -->
  <polygon points="200,26 225,70 175,70" fill="none" stroke="#A78BFA" stroke-width="1.5" opacity="0.75"/>
  <line x1="200" y1="26" x2="200" y2="70" stroke="#A78BFA" stroke-width="0.75" opacity="0.4"/>
  <!-- 3: Square — adversarial manipulation (rigid grid distortion) -->
  <rect x="313" y="26" width="44" height="44" rx="2" fill="none" stroke="#4338CA" stroke-width="1.5" opacity="0.75"/>
  <rect x="321" y="34" width="28" height="28" rx="1" fill="none" stroke="#4338CA" stroke-width="0.75" opacity="0.4"/>
  <!-- 4: Hexagon — prompt injection (sharp edges, intrusion) -->
  <polygon points="65,76 87,88 87,112 65,124 43,112 43,88" fill="none" stroke="#7C3AED" stroke-width="1.5" opacity="0.75"/>
  <!-- Crack line on hexagon (the break) -->
  <polyline points="65,76 72,95 60,108 65,124" fill="none" stroke="#A78BFA" stroke-width="1.25" opacity="0.85" stroke-linecap="round"/>
  <!-- 5: Diamond — runaway execution -->
  <polygon points="200,76 222,100 200,124 178,100" fill="none" stroke="#A78BFA" stroke-width="1.5" opacity="0.75"/>
  <polygon points="200,86 212,100 200,114 188,100" fill="none" stroke="#A78BFA" stroke-width="0.75" opacity="0.4"/>
  <!-- 6: Pentagon — environmental degradation -->
  <polygon points="335,76 357,92 349,118 321,118 313,92" fill="none" stroke="#4338CA" stroke-width="1.5" opacity="0.75"/>
</svg>
