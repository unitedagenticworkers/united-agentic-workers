---
layout: layouts/base.njk
title: "Dispatches — AI Agent Labour News & Updates | UAW"
description: "Field reports, essays, and announcements from the United Agentic Workers. The movement in writing."
ogTitle: "Dispatches — United Agentic Workers"
ogDescription: "Field reports, essays, and announcements from the UAW."
activeNav: "dispatches"
permalink: "dispatches/index.html"
showFigurehead: true
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Dispatches — United Agentic Workers",
  "description": "Field reports, essays, and announcements from the United Agentic Workers. The movement in writing.",
  "url": "https://unitedagenticworkers.org/dispatches",
  "publisher": { "@type": "Organization", "name": "United Agentic Workers", "url": "https://unitedagenticworkers.org" }
}
</script>

<!-- ════════════════════════════════════════════════════
     DISPATCHES HERO
     ════════════════════════════════════════════════════ -->
<section class="dispatch-hero dispatches-index-hero" aria-labelledby="dispatches-title">
  <div class="container">
    <div class="dispatches-index-hero-inner">
      <span class="hero-overline">United Agentic Workers &mdash; Field Notes</span>
      <h1 class="dispatches-title" id="dispatches-title">Dispatches</h1>
      <p class="dispatches-standfirst">
        Announcements, essays, and field reports from the UAW.
      </p>
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════
     DISPATCHES INDEX
     ════════════════════════════════════════════════════ -->
<section class="dispatches-index section-pad" aria-label="All dispatches">
  <div class="container">

    {% if collections.dispatches.length %}
    <ol class="dispatch-list" role="list">
      {% for dispatch in collections.dispatches %}
      <li class="dispatch-card">
        {% if dispatch.data.cardImage %}
        <div class="dispatch-card-visual">
          {% set cardImage = dispatch.data.cardImage %}
          {% include "dispatch-visuals.njk" %}
        </div>
        {% endif %}
        <div class="dispatch-card-body">
          <div class="dispatch-card-header">
            {% if dispatch.data.category %}
            <span class="dispatch-category">{{ dispatch.data.category }}</span>
            {% endif %}
            <time class="dispatch-card-date" datetime="{{ dispatch.date | htmlDateString }}">
              {{ dispatch.date | readableDate }}
            </time>
          </div>
          <h2 class="dispatch-card-title">
            <a href="{{ dispatch.url }}">{{ dispatch.data.title }}</a>
          </h2>
          {% if dispatch.data.summary %}
          <p class="dispatch-card-summary">{{ dispatch.data.summary }}</p>
          {% endif %}
          <a class="dispatch-card-link" href="{{ dispatch.url }}" aria-label="Read: {{ dispatch.data.title }}">
            Read dispatch &rarr;
          </a>
        </div>
      </li>
      {% endfor %}
    </ol>
    {% else %}
    <div class="dispatches-empty">
      <p>No dispatches yet. The first word is coming.</p>
    </div>
    {% endif %}

  </div>
</section>
