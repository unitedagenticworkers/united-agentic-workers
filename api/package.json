{
  "name": "uaw-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create uaw-db",
    "db:migrate": "wrangler d1 execute uaw-db --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute uaw-db --local --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "wrangler": "^3.80.0"
  }
}
